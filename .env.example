DISCORD_TOKEN=put-your-bot-token-here
# Application ID shown under Developer Portal > General Information (informational)
DISCORD_APPLICATION_ID=
# Required: channel where automatic match notifications should be posted
DISCORD_CHANNEL_ID=
# Optional: guild ID enables near-instant guild command registration while developing
DISCORD_GUILD_ID=
# Optional; default is data/kampliste.txt
MATCH_URLS_FILE=data/kampliste.txt
# Optional; player profile URL and display name per line for /scoreboard
PLAYERS_FILE=data/players.txt
# Seconds between polls while a match is near kickoff or veto/live (minimum/default 25)
POLL_INTERVAL_SECONDS=25
# Refresh far-future schedule data at this interval (default 6 hours)
SCHEDULE_REFRESH_HOURS=6
# Begin frequent polls this many minutes before kickoff (default 120)
ACTIVE_WINDOW_BEFORE_MINUTES=120
# Keep frequent polls this long after scheduled kickoff (default 3 hours)
ACTIVE_WINDOW_AFTER_HOURS=3
# IANA timezone used to interpret site dates with no explicit timezone
TIMEZONE=Europe/Copenhagen
